# Copy to .env for local development. Never commit the real file.

# Every 511 key you hold, comma-separated. Order is irrelevant; keypool.ts spreads
# load across all of them, so the pool's size is the budget: 10 keys = 600/hour.
FIVEELEVEN_API_KEYS=key-one,key-two,key-three

# 511's per-key hourly ceiling. Their default is 60; set this only if they grant
# you an increase (transitdata@511.org), so /health reports the real budget.
FIVEELEVEN_HOURLY_LIMIT=60

# Railway sets this automatically once you add the Redis plugin.
# Locally: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Apple Developer team ID, and the bundle ID of the *app* target.
APPLE_TEAM_ID=ABCDE12345
APP_BUNDLE_ID=wato.BayTransit-Widgets

# Signs session tokens. Any long random string; rotating it logs every device out.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Development only. Both of these are security holes; leave unset in production. ---
# Accept attestations from Xcode-signed debug builds.
ALLOW_DEV_ATTESTATION=false
# A fixed token the Simulator can send instead of attesting.
DEV_BYPASS_TOKEN=

# --- Server-side polling ---------------------------------------------------
# The poller keeps a full snapshot of every agency in Redis, so client requests
# are answered from Redis and never reach 511.
#
# rg (default) -- 511's consolidated regional feed. Two requests per cycle
#   (tripupdates + vehiclepositions, both agency=RG) covering every operator,
#   no matter how many agencies are listed below:
#     2 / 15s = 480 requests/hour   <- default, fits 10 keys with room spare
#     2 / 30s = 240 requests/hour
#   Plus one request a day for the static GTFS archive that supplies route
#   names and destinations.
#
# siri -- the old per-agency sweep, kept only as a fallback if the regional
#   feed breaks. Costs one request PER AGENCY per cycle, so raise the interval
#   to 60 if you switch to it or the budget guard will (correctly) shout.
POLL_ENABLED=true
POLL_MODE=rg
POLL_INTERVAL_SECONDS=15

# In rg mode this is a filter on the regional feed, not a request plan -- adding an agency
# costs no extra requests, because both protobufs already contain every operator.
#
# `*` (the default) publishes all of them and discovers the list from the feed rather than
# maintaining one, so an operator joining 511 appears on its own and one leaving stops being
# reported as permanently stale.
#
# IMPORTANT: this interacts with POLL_MODE. In siri mode the cost is one request PER AGENCY
# per cycle, so `*` there is thousands of requests an hour against a budget of 600 --
# arithmetically impossible. If you ever switch to siri, set a named subset here as well as
# raising POLL_INTERVAL_SECONDS.
POLLED_AGENCIES=*

# Index the regional vehicle-position feed (the second of the two requests).
# Set false to halve the poll cost if you don't need /v1/vehicles.
POLL_VEHICLES=true

# How often to rebuild the static GTFS tables that supply route names and
# simplified destinations. One request. Daily is already generous -- these
# change when a service change ships, a few times a year.
STATIC_REFRESH_HOURS=24

# Whether the stop a user is looking at may still fetch live when its snapshot
# has aged past ON_DEMAND_AFTER_SECONDS. Off in rg mode: at a 15s sweep every
# stop is already fresher than this path's own 45s cache, so a live fetch could
# only return staler data at the cost of a request.
ON_DEMAND_ENABLED=false
ON_DEMAND_AFTER_SECONDS=45

# --- BART -------------------------------------------------------------------
# BART is the only operator that publishes no vehicle positions anywhere -- not
# to 511, and not in its own GTFS-RT. Its trains are placed on the map by
# interpolating between predicted stop times along the track geometry, so every
# BART position is an estimate and is tagged source=synthesized.
#
# None of this costs 511 requests. BART's GTFS-RT needs no key at all; only
# etd.aspx does, and that is what supplies platform number, car count, delay
# seconds and the authoritative "Leaving" flag.
BART_ENABLED=true

# Register your own at https://api.bart.gov/api/register.aspx -- the default is
# BART's shared public key, on an API they themselves label "legacy". Fine for
# local development, not for production traffic.
BART_API_KEY=

# How often to refetch ETD. The response is reused between fetches, so this does
# not have to match the poll interval.
BART_ETD_INTERVAL_SECONDS=30

# Place BART trains on the map. Off means no BART positions at all, since there
# is no upstream to fall back on.
BART_SYNTHESIZE_VEHICLES=true

# Merge BART's own trip feed with 511's. Leave off without a reason: BART
# publishes ~70 trips to 511's ~60, but the board and the map must come from the
# same numbers or they disagree -- a train drawn between two stations while the
# board says it already left.
BART_OWN_TRIPUPDATES=false


# --- The delay profile ------------------------------------------------------
# The historical half of this service: record what actually happened at every stop, learn
# where each segment of each route loses and regains time, and publish corrected predictions
# on /v1/predictions. See docs/00-overview.md.
#
# It costs ZERO extra 511 requests -- it learns from bytes we already pay for. The only new
# upstream cost is parsing more of the archive we already download once a day.
#
# And it can never affect /v1/departures. With no DATABASE_URL the service boots, serves
# every endpoint exactly as before, and simply learns nothing.

PROFILE_ENABLED=true

# Which operators get a history. Deliberately a short list rather than everything the feed
# carries: learning a profile means storing a stop-level event for every vehicle at every
# stop all day, and there is no reason to pay that for an operator nobody has asked about.
# SF=Muni, BA=BART, CT=Caltrain, SM=SamTrans, GG=Golden Gate Transit.
PROFILED_AGENCIES=SF,BA,CT,SM,GG

# How fast the profile forgets. Three weeks: long enough to survive a quiet fortnight on a
# Sunday route, short enough that a signal retimed in March stops arguing in June.
PROFILE_HALF_LIFE_DAYS=21

# Within-day correlation between consecutive trips on a route, used to discount sample
# sizes. Two buses ten minutes apart share nearly all their causes, so counting them as
# independent observations inflates every n in the system and makes every confidence
# interval too narrow. Measure it per agency once there is history; this is the prior.
PROFILE_ICC=0.5

# Seconds past its published time a held vehicle actually leaves a timepoint. Not zero:
# drivers wait out the clock and pull away a few seconds late, and assuming exactly zero
# makes every timepoint look slightly late.
PROFILE_HOLD_OFFSET=12

# How often the learner folds new observations in. Never inside a poll cycle.
PROFILE_LEARN_INTERVAL=300

# Days of raw stop-level history kept before the daily partition is dropped. Profiles are
# kept indefinitely -- they are the durable artefact, and if this table were lost, three
# months of learning would still be there.
PROFILE_RETENTION_DAYS=90

# How much of the observation stream may back up in Redis before the oldest is dropped.
# This is the rule "losing history is preferable to delaying a departure", as a number.
PROFILE_STREAM_MAXLEN=200000

# --- Corrected predictions --------------------------------------------------
# off    -- compute nothing
# shadow -- compute, log and score, but report every prediction as the agency's own number
# on     -- let the evidence decide, per agency and per horizon (see docs/07-evaluation.md)
#
# None of these can change /v1/departures, which serves raw agency times in every mode.
PREDICTION_MODE=shadow

# Effective samples below which a segment never offers a correction at all.
PREDICTION_MIN_SAMPLES=3

# --- The warehouse ----------------------------------------------------------
# Railway sets this when you add the Postgres plugin. Absent is a supported configuration,
# not a broken one.
DATABASE_URL=
DATABASE_POOL_SIZE=4
# Set false on a replica that must not race the leader through migrations.
DATABASE_MIGRATE=true
