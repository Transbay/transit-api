{
  "name": "transitapi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "static": "node dist/index.static.js",
    "dev": "tsc --watch & node --watch dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@peculiar/x509": "^1.11.0",
    "cbor-x": "^1.5.9",
    "fastify": "^4.28.1",
    "gtfs-realtime-bindings": "^1.1.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.10",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.5.4"
  }
}
